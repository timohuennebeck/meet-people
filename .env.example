# Supabase — local development defaults (supabase start prints these).
# The publishable key replaces the legacy JWT anon key and looks like
# sb_publishable_… — it is safe to ship in the app; the secret key never is.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

