{
  "name": "treff",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "printf '// Generated by `npm run db:types` — do not edit by hand.\\n\\n' > src/shared/lib/supabase/database.types.ts && supabase gen types typescript --project-id lwiexavsvbydlpfzxpvy >> src/shared/lib/supabase/database.types.ts"
  },
